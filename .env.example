# Copy this file to .env for local development.
# The real .env file is ignored by Git; never commit credentials.

# Meta / Facebook Login for Business
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_OAUTH_CONFIG_ID=your_facebook_login_for_business_config_id
META_GRAPH_API_VERSION=v26.0
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/facebook/callback

# Optional video settings
CHUNK_SECONDS=180
MAX_UPLOAD_MB=5120
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
UPLOAD_WATCH_INTERVAL=15
