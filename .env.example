# Copy this file to .env for local development.
# The real .env is ignored by Git; never commit credentials.

# Managed social connection provider (recommended for Facebook).
# This replaces the need to enter Meta App ID/Secret in the local app.
UPLOAD_POST_API_BASE=https://api.upload-post.com
UPLOAD_POST_API_KEY=your_upload_post_api_key
UPLOAD_POST_PROFILE=video_splitter_local

# Optional direct Meta integration (legacy/development fallback only).
META_APP_ID=
META_APP_SECRET=
META_OAUTH_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/facebook/callback

# Optional video settings
CHUNK_SECONDS=180
MAX_UPLOAD_MB=5120
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
UPLOAD_WATCH_INTERVAL=15
